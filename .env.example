# 前端请求基础地址。生产环境接口统一使用 /flame/api 前缀；本地联调可替换为实际后端地址。
VUE_APP_API_BASE_URL=http://127.0.0.1:8000/flame/api

# 应用模式：development 使用下面的开发 auth_code；production 使用钉钉免登。
# 仅支持 development 和 production 两个值。
VUE_APP_MODE=development

# 开发环境直接提交给后端登录接口的 auth_code，请替换为实际值；不要写入生产构建环境。
VUE_APP_AUTH_CODE=ccb

# 商城兑换窗口：从当前赛季开始日起，允许兑换的自然日数。未配置或配置无效时默认 7 天。
VUE_APP_SHOP_REDEEM_WINDOW_DAYS=7

# 浏览器页签和钉钉 WebView 显示的应用名称。未配置或为空时默认“燃动现象”。
VUE_APP_PAGE_TITLE=燃动现象

# 钉钉 H5 免登配置。auto 模式下仅在钉钉客户端内使用。
# 也可在页面 URL query 中传入 corpId 和 clientId。
VUE_APP_DINGTALK_CORP_ID=
VUE_APP_DINGTALK_CLIENT_ID=
VUE_APP_DINGTALK_JSAPI_URL=https://g.alicdn.com/dingding/open-develop/1.9.0/dingtalk.js
